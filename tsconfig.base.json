{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2019", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@amusite/shared": ["packages/shared/src/index.ts"],
      "@amusite/utils": ["packages/utils/src/index.ts"],
      "@amusite/request": ["packages/request/src/index.ts"],
      "@amusite/vue-core": ["packages/vue-core/src/index.ts"],
      "@amusite/styles": ["packages/styles/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["vitest/globals"]
  }
}
