{
  "name": "@amusite/styles",
  "version": "0.2.0",
  "description": "Shared CSS variables and admin layout helpers.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/socalledPF/frontend-kit.git",
    "directory": "packages/styles"
  },
  "keywords": [
    "amusite",
    "css",
    "design-tokens"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup && cp src/index.css dist/index.css",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "sideEffects": [
    "*.css"
  ]
}
