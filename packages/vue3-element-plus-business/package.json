{
  "name": "@amusite/vue3-element-plus-business",
  "version": "0.0.0",
  "description": "Vue3 + Element Plus business components for RuoYi-style admin pages.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,vue}\""
  },
  "peerDependencies": {
    "element-plus": "^2.7.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@amusite/business-core": "workspace:*",
    "@amusite/utils": "workspace:*",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.14.4",
    "jsdom": "^24.1.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "sideEffects": ["*.css"]
}
